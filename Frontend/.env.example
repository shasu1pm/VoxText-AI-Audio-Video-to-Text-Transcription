# VoxText Frontend Environment Variables
# Copy this file to .env and update the values

# Backend API URL (for production deployment)
# Leave empty for local development (uses Vite proxy)
VITE_BACKEND_URL=

# For Cloudflare Pages deployment, set the API endpoint explicitly:
# VITE_TRANSCRIBE_URL=https://your-backend.example.com/transcribe
# (or) VITE_API_BASE_URL=https://your-backend.example.com
